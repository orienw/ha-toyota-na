  dict({
    'outcome': 'returned',
    'requests': list([
      dict({
        'body': dict({
          'operationName': 'ConfirmSubscriptionStatus',
          'query': '''
            mutation ConfirmSubscriptionStatus($vin: String!, $backdoorType: String!) {
              confirmSubscriptionActive(vin: $vin, payload: {
                vehicleCapabilities: { backdoorType: $backdoorType }
              }) { vin }
            }
          ''',
          'variables': dict({
            'backdoorType': 'hatch',
            'vin': 'VIN0000000000TEST',
          }),
        }),
        'headers': dict({
          'Authorization': 'Bearer access-token',
          'Content-Type': 'application/json',
